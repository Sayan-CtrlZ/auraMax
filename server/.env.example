# ==============================================================================
# AuraMax FastAPI Server - Environment Variables Configuration Template
# Copy this file to a new file named '.env' and fill in the values.
# ==============================================================================

# ── SERVER CONFIGURATION ──────────────────────────────────────────────────────
PORT=8000
HOST=0.0.0.0
DEBUG=True
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-deployment.vercel.app

# ── AWS BEDROCK API ─────────────────────────────────────────────────────────────
# Get your credentials from AWS IAM with Bedrock InvokeModel permissions
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_DEFAULT_REGION=us-east-1

# ── SUPABASE CONFIGURATION (AUTH & HISTORY) ───────────────────────────────────
# Get these from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── NEON DATABASE (POSTGRESQL FOR PRODUCTS) ───────────────────────────────────
# Get your connection string from Neon Dashboard (https://neon.tech)
# Make sure to use the 'postgresql+asyncpg://' prefix for async Python support
NEON_DATABASE_URL=postgresql+asyncpg://user:password@ep-your-branch-id.region.aws.neon.tech/neondb?sslmode=require

# ── CLOUDINARY CONFIGURATION (IMAGE UPLOADS) ──────────────────────────────────
# Get these from your Cloudinary Dashboard
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# ── HUGGING FACE (FLUX.1-SCHNELL OUTFIT GENERATION) ───────────────────────────
# Get your Read token from Hugging Face -> Settings -> Access Tokens (https://huggingface.co)
HUGGINGFACE_API_KEY=hf_your_huggingface_access_token_here

# ── SECURITY ──────────────────────────────────────────────────────────────────
# Secret key used for JWT signing and sessions
SECRET_KEY=your_secret_key_here

# ── EXTERNAL SEARCH APIs ────────────────────────────────────────────────────────
SERPER_API_KEY=your_serper_api_key_here
SERPAPI_API_KEY=your_serpapi_api_key_here

FIREBASE_WEB_API_KEY=your_firebase_web_api_key_here

