# ==============================================================================
# AuraMax FastAPI Server - Environment Variables Configuration Template
# Copy this file to '.env' and fill in the values.
# ==============================================================================

# ── SERVER CONFIGURATION ──────────────────────────────────────────────────────
PORT=8000
HOST=0.0.0.0
DEBUG=False
ALLOWED_ORIGINS=http://localhost:3000,https://auramax.onrender.com,https://auramax.vercel.app

# ── GROQ API (LLAMA 3 / LLAMA 3.3) ───────────────────────────────────────────
# Get your API key from console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── FIREBASE ADMIN SDK CONFIGURATION ─────────────────────────────────────────
# For Render deployment (Option A - Direct Env Vars):
FIREBASE_PROJECT_ID=aura-max-cd5b5
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@aura-max-cd5b5.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# For Local Dev (Option B - File path):
# GOOGLE_APPLICATION_CREDENTIALS=aura-max-cd5b5-firebase-adminsdk-fbsvc-7b3a82ad77.json

